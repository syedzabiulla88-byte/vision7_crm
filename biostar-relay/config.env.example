# Vision7 BioStar Relay settings. Copy this file to "config.env" and fill in the values.
# Keep config.env private: it holds the BioStar login. It is never committed to git.

# --- BioStar 2 server (the machine that runs BioStar) ---
BIOSTAR_HOST=10.1.100.46
BIOSTAR_PORT=443

# --- The BioStar account the relay signs in with ---
# Use a DEDICATED administrator account (e.g. vision7-relay), not a person's login,
# so changing someone's password or adding staff never breaks the CRM connection.
BIOSTAR_LOGIN=CHANGE_ME
BIOSTAR_PASSWORD=CHANGE_ME

# --- This relay ---
# Which CRM address(es) may call the relay from the browser, comma-separated.
ALLOWED_ORIGINS=https://crm.vision7.sa
# Port the relay listens on (https)
PORT=8443

# Optional shared key. Leave blank: the CRM does not send one.
RELAY_KEY=
